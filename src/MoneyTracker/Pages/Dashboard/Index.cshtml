@page
@model MoneyTracker.Pages.Dashboard.IndexModel
@using MoneyTracker.Services.Dashboard
@{
    ViewData["Title"] = "Dashboard";
    string Money(decimal v) => v.ToString("N2") + " €";
    var d = Model.Data;
}

<h1>Dashboard</h1>

<div class="card">
    <form method="get" class="filters">
        <div class="field">
            <label>Περίοδος</label>
            <select name="Preset" onchange="this.form.submit()">
                @foreach (var p in Enum.GetValues<DateRangePreset>())
                {
                    if (Model.Preset == p)
                    {
                        <option value="@p" selected>@PresetLabel(p)</option>
                    }
                    else
                    {
                        <option value="@p">@PresetLabel(p)</option>
                    }
                }
            </select>
        </div>
        <div class="field">
            <label>Από</label>
            <input type="date" name="From" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="field">
            <label>Έως</label>
            <input type="date" name="To" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit" class="primary">Εφαρμογή</button>
        <span class="muted" style="align-self:center">@d.From.ToString("dd/MM/yyyy") – @d.To.ToString("dd/MM/yyyy")</span>
    </form>
</div>

<div class="stat-grid">
    <div class="stat"><div class="label">Έσοδα</div><div class="value income">@Money(d.TotalIncome)</div></div>
    <div class="stat"><div class="label">Έξοδα</div><div class="value expense">@Money(d.TotalExpenses)</div></div>
    <div class="stat"><div class="label">Υπόλοιπο</div><div class="value">@Money(d.Balance)</div></div>
    <div class="stat"><div class="label">Κινήσεις</div><div class="value">@d.TransactionCount</div></div>
    <div class="stat"><div class="label">Μέσο έξοδο</div><div class="value">@Money(d.AverageExpense)</div></div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:1rem; margin-top:1rem;">
    <div class="card">
        <h2>Έξοδα ανά κατηγορία</h2>
        @if (d.ExpensesByCategory.Any())
        {
            <ul class="tree">
                @foreach (var n in d.ExpensesByCategory)
                {
                    <partial name="_CategoryNode" model="n" />
                }
            </ul>
        }
        else
        {
            <p class="muted">Δεν υπάρχουν έξοδα στην περίοδο.</p>
        }
        @if (d.UncategorizedExpenses > 0)
        {
            <p class="muted" style="margin-top:.75rem">Χωρίς κατηγορία: <strong>@Money(d.UncategorizedExpenses)</strong></p>
        }
    </div>

    <div class="card">
        <h2>Κορυφαίοι έμποροι</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Έμπορος</th><th class="num">Ποσό</th><th class="num">#</th></tr></thead>
                <tbody>
                @foreach (var m in d.TopMerchants)
                {
                    <tr><td>@m.Merchant</td><td class="num">@Money(m.Amount)</td><td class="num">@m.Count</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:1rem; margin-top:1rem;">
    <div class="card">
        <h2>Ανά μήνα</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Μήνας</th><th class="num">Έξοδα</th><th class="num">Έσοδα</th></tr></thead>
                <tbody>
                @foreach (var m in d.ByMonth)
                {
                    <tr><td>@m.Label</td><td class="num">@Money(m.Expenses)</td><td class="num">@Money(m.Income)</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h2>Μεγαλύτερα έξοδα</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Ημ/νία</th><th>Περιγραφή</th><th class="num">Ποσό</th></tr></thead>
                <tbody>
                @foreach (var t in d.LargestExpenses)
                {
                    <tr>
                        <td>@t.TransactionDate.ToString("dd/MM/yyyy")</td>
                        <td>@t.NormalizedDescription</td>
                        <td class="num">@Money(t.Amount)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    static string PresetLabel(DateRangePreset p) => p switch
    {
        DateRangePreset.Today => "Σήμερα",
        DateRangePreset.ThisWeek => "Αυτή η εβδομάδα",
        DateRangePreset.ThisMonth => "Αυτός ο μήνας",
        DateRangePreset.PreviousMonth => "Προηγούμενος μήνας",
        DateRangePreset.ThisYear => "Φέτος",
        DateRangePreset.Custom => "Προσαρμοσμένο",
        _ => p.ToString()
    };
}
