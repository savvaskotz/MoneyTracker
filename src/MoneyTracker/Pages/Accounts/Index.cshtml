@page
@model MoneyTracker.Pages.Accounts.IndexModel
@{
    ViewData["Title"] = "Λογαριασμοί";
}
<h1>Λογαριασμοί</h1>
<p class="muted">Κάθε κίνηση ανήκει σε έναν λογαριασμό. Στο import διαλέγεις σε ποιον θα μπουν οι κινήσεις.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert error">@Model.Error</div>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert ok">@Model.Message</div>
}

<div class="card">
    <h2>Νέος λογαριασμός</h2>
    <form method="post" class="filters">
        <div class="field">
            <label>Όνομα</label>
            <input name="NewName" required placeholder="π.χ. Πιστωτική Πειραιώς" />
        </div>
        <button type="submit" asp-page-handler="Create" class="primary">Δημιουργία</button>
    </form>
</div>

<div class="card">
    <h2>Υπάρχοντες λογαριασμοί</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Όνομα</th><th class="num">Κινήσεις</th><th>Μετονομασία</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Accounts)
            {
                <tr>
                    <td>@a.Name</td>
                    <td class="num">@a.TransactionCount</td>
                    <td>
                        <form method="post" style="display:flex; gap:.4rem;">
                            <input type="hidden" name="RenameId" value="@a.Id" />
                            <input type="text" name="RenameName" value="@a.Name" />
                            <button type="submit" asp-page-handler="Rename" class="ghost">Αποθήκευση</button>
                        </form>
                    </td>
                    <td>
                        @if (a.TransactionCount == 0)
                        {
                            <form method="post" onsubmit="return confirm('Διαγραφή λογαριασμού;');">
                                <button type="submit" asp-page-handler="Delete" asp-route-id="@a.Id" class="ghost">Διαγραφή</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
