<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / ASP.NET Core Module config for shared hosting (SmarterASP.NET).
  Launches via `dotnet .\MoneyTracker.dll` (no platform apphost), so it runs
  regardless of the app pool bitness. stdout logging is on temporarily to
  capture any startup error into .\stdout_*.log at the site root.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\MoneyTracker.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
