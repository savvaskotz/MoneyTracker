@page "{id:int}"
@model MoneyTracker.Pages.Import.PreviewModel
@using MoneyTracker.Domain
@{
    ViewData["Title"] = "Preview εισαγωγής";
    string Money(decimal v) => v.ToString("N2") + " €";
    string SrcLabel(SuggestionSource s) => s switch
    {
        SuggestionSource.UserRule => "Κανόνας",
        SuggestionSource.History => "Ιστορικό",
        SuggestionSource.LearnedRule => "Εκμάθηση",
        SuggestionSource.BankCategory => "Τράπεζα",
        _ => "—"
    };
}

<h1>Preview εισαγωγής</h1>
<div class="card">
    <strong>@Model.Batch.FileName</strong>
    <span class="muted"> · Σύνολο: @Model.Batch.TotalRows ·
        <span class="badge new">Νέες @Model.Batch.NewCount</span>
        <span class="badge src">Ενημέρωση @Model.Batch.UpdatedCount</span>
        <span class="badge dup">Διπλότυπα αρχείου @Model.Batch.DuplicateCount</span>
    </span>
    <p class="muted">
        Ξετσέκαρε όποια γραμμή δεν θέλεις για να μην εισαχθεί. Οι γραμμές με «Ενημέρωση»
        υπάρχουν ήδη (ίδιο παραστατικό) και θα ενημερωθούν αντί να διπλοκαταχωρηθούν.
        Οι κατηγορίες δεν δημιουργούνται αυτόματα — φτιάξ' τες από τις «Κατηγορίες».
    </p>
</div>

<form method="post">
    <div class="table-wrap card">
        <table>
            <thead>
                <tr>
                    <th>Εισαγωγή</th>
                    <th>#</th>
                    <th>Ημ/νία</th>
                    <th>Περιγραφή</th>
                    <th class="num">Ποσό</th>
                    <th>Πρόταση</th>
                    <th>Κατηγορία</th>
                    <th>Κατάσταση</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                var suggestedPath = row.SuggestedCategoryId is int sid && Model.CategoryPaths.TryGetValue(sid, out var p)
                    ? p : "Δεν βρέθηκε κατηγορία";
                var isSkippable = row.DuplicateReason == "DuplicateInFile";
                <tr>
                    <td>
                        @if (!isSkippable)
                        {
                            <input type="checkbox" name="Included[@row.Id]" value="true" @(row.Included ? "checked" : null) />
                        }
                    </td>
                    <td class="muted">@row.RowIndex</td>
                    <td>@row.TransactionDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @row.OriginalDescription
                        <div class="muted" style="font-size:.8rem">@row.NormalizedDescription</div>
                    </td>
                    <td class="num @(row.Type == TransactionType.Expense ? "value expense" : "value income")"
                        style="font-size:1rem">
                        @(row.Type == TransactionType.Expense ? "-" : "+")@Money(row.Amount)
                    </td>
                    <td>
                        <span class="badge src">@SrcLabel(row.SuggestionSource)</span>
                        <div class="muted" style="font-size:.8rem">@suggestedPath</div>
                    </td>
                    <td>
                        @if (isSkippable)
                        {
                            <span class="muted">—</span>
                        }
                        else
                        {
                            <select name="Selected[@row.Id]">
                                <option value="">— Χωρίς κατηγορία —</option>
                                @foreach (var opt in Model.CategoryOptions)
                                {
                                    if (row.SelectedCategoryId == opt.Id)
                                    {
                                        <option value="@opt.Id" selected>@opt.Path</option>
                                    }
                                    else
                                    {
                                        <option value="@opt.Id">@opt.Path</option>
                                    }
                                }
                            </select>
                        }
                    </td>
                    <td>
                        @if (row.DuplicateReason == "ExistsInDb")
                        {
                            <span class="badge src">Ενημέρωση</span>
                        }
                        else if (row.DuplicateReason == "DuplicateInFile")
                        {
                            <span class="badge dup">Διπλό (αρχείο)</span>
                        }
                        else
                        {
                            <span class="badge new">New</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="card" style="display:flex; gap:.75rem;">
        <button type="submit" asp-page-handler="Confirm" class="primary">Επιβεβαίωση εισαγωγής</button>
        <button type="submit" asp-page-handler="Cancel" class="ghost">Ακύρωση</button>
    </div>
</form>
