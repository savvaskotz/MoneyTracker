@model MoneyTracker.Services.Dashboard.CategoryTotalNode
@{
    string Money(decimal v) => v.ToString("N2") + " €";
    var preset = ViewData["Preset"]?.ToString();
    var from = ViewData["From"]?.ToString();
    var to = ViewData["To"]?.ToString();
}
<li>
    @if (Model.Children.Any())
    {
        <details>
            <summary>
                <a asp-page="/Dashboard/Category" asp-route-id="@Model.CategoryId"
                   asp-route-Preset="@preset" asp-route-From="@from" asp-route-To="@to">@Model.Name</a>
                <span class="right">@Money(Model.Total)</span>
            </summary>
            <ul class="tree child">
                @foreach (var c in Model.Children)
                {
                    <partial name="_CategoryNode" model="c" />
                }
                @if (Model.Direct > 0)
                {
                    <li>
                        <span class="muted">(άμεσα σε @Model.Name)</span>
                        <span class="right">@Money(Model.Direct)</span>
                    </li>
                }
            </ul>
        </details>
    }
    else
    {
        <div style="display:flex; justify-content:space-between;">
            <a asp-page="/Dashboard/Category" asp-route-id="@Model.CategoryId"
               asp-route-Preset="@preset" asp-route-From="@from" asp-route-To="@to">@Model.Name</a>
            <span class="right">@Money(Model.Total)</span>
        </div>
    }
</li>
